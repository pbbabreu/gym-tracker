    {
      "id": "dumbbell-incline-press",
      "name": "Supino inclinado com halteres",
      "type": "hypertrophy",
      "compound": true,
      "regime": "weighted",
      "mainMuscle": "chest",
      "movementPattern": "press",
      "movement": "incline-press",
      "accessoryMuscles": [
        "shoulders",
        "triceps"
      ],
      "name_en": "Dumbbell incline press",
      "aliases": [
        "dumbbell incline press",
        "inclinado halteres",
        "db incline",
        "supino inclinado halter"
      ],
      "equipment": "dumbbell",
      "cues_pt": [
        "Banco entre 30° e 45° — mais que isso vira desenvolvimento de ombro",
        "Halteres partem da linha do peitoral superior, cotovelos sob os punhos",
        "Trajetória sobe levemente para trás, terminando acima das clavículas"
      ],
      "cues_en": [
        "Bench between 30° and 45° — steeper turns it into a shoulder press",
        "Dumbbells start at the upper-chest line, elbows stacked under wrists",
        "Bar path drifts slightly back, finishing above the collarbones"
      ],
      "errors_pt": [
        "Inclinar demais o banco e transferir o trabalho para os ombros",
        "Deixar os ombros descolarem do banco no esforço final"
      ],
      "errors_en": [
        "Setting the bench too steep and handing the work to the shoulders",
        "Letting the shoulders peel off the bench on the final grind"
      ],
      "stretchEmphasis": false
    },
