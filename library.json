    {
      "id": "v-bar-lat-pulldown",
      "name": "Puxada com triângulo",
      "type": "hypertrophy",
      "compound": true,
      "regime": "weighted",
      "mainMuscle": "back",
      "movementPattern": "pulldown",
      "movement": "lat-pulldown",
      "accessoryMuscles": [
        "biceps"
      ],
      "name_en": "V-bar lat pulldown",
      "aliases": [
        "puxada triangulo",
        "puxada pegada neutra",
        "v bar pulldown",
        "neutral grip pulldown"
      ],
      "equipment": "cable",
      "cues_pt": [
        "Pegada neutra no triângulo, palmas viradas uma para a outra",
        "Puxe até o triângulo chegar perto do esterno, cotovelos junto ao corpo",
        "Suba controlando até esticar por completo"
      ],
      "cues_en": [
        "Neutral grip on the handle, palms facing each other",
        "Pull until the handle nears the sternum, elbows tracking close",
        "Return under control to full extension"
      ],
      "errors_pt": [
        "Encolher os ombros na parte final da puxada",
        "Inclinar demais o tronco para trás e transformar em remada"
      ],
      "errors_en": [
        "Shrugging at the end of the pull",
        "Leaning back so far it turns into a row"
      ]
    },
    {
      "id": "close-grip-lat-pulldown",
      "name": "Puxada frontal fechada",
      "type": "hypertrophy",
      "compound": true,
      "regime": "weighted",
      "mainMuscle": "back",
      "movementPattern": "pulldown",
      "movement": "lat-pulldown",
      "accessoryMuscles": [
        "biceps"
      ],
      "name_en": "Close-grip lat pulldown",
      "aliases": [
        "puxada fechada",
        "close grip lat pulldown",
        "close grip pulldown"
      ],
      "equipment": "cable",
      "cues_pt": [
        "Peito alto e leve inclinação para trás — a barra desce em direção ao alto do peito",
        "Pense em puxar com os cotovelos para baixo, não com as mãos",
        "Deixe os ombros subirem no topo antes de puxar de novo"
      ],
      "cues_en": [
        "Chest tall with a slight lean back — the bar comes to the upper chest",
        "Think about driving the elbows down rather than pulling with the hands",
        "Let the shoulders rise at the top before the next rep"
      ],
      "errors_pt": [
        "Jogar o tronco para trás para vencer a carga",
        "Parar antes de esticar os braços e perder o alongamento no topo"
      ],
      "errors_en": [
        "Swinging the torso back to move the weight",
        "Cutting the top short and losing the stretch"
      ]
    },
    {
      "id": "underhand-lat-pulldown",
      "name": "Puxada supinada",
      "type": "hypertrophy",
      "compound": true,
      "regime": "weighted",
      "mainMuscle": "back",
      "movementPattern": "pulldown",
      "movement": "lat-pulldown",
      "accessoryMuscles": [
        "biceps"
      ],
      "name_en": "Underhand lat pulldown",
      "aliases": [
        "puxada inversa",
        "underhand cable pulldown",
        "reverse grip pulldown",
        "supinada"
      ],
      "equipment": "cable",
      "cues_pt": [
        "Pegada supinada na largura dos ombros, cotovelos rentes ao corpo",
        "Puxe até a barra encostar na parte alta do abdômen",
        "Segure um instante embaixo antes de subir"
      ],
      "cues_en": [
        "Underhand grip about shoulder width, elbows tracking close to the body",
        "Pull until the bar meets the upper abdomen",
        "Pause briefly at the bottom before returning"
      ],
      "errors_pt": [
        "Deixar o bíceps fazer todo o trabalho e virar uma rosca",
        "Abrir os cotovelos, o que tira a vantagem da pegada supinada"
      ],
      "errors_en": [
        "Letting the biceps take over until it becomes a curl",
        "Flaring the elbows, which throws away the point of the underhand grip"
      ]
    },
    {
      "id": "one-arm-lat-pulldown",
      "name": "Puxada unilateral",
      "type": "hypertrophy",
      "compound": true,
      "regime": "weighted",
      "mainMuscle": "back",
      "movementPattern": "pulldown",
      "movement": "lat-pulldown",
      "accessoryMuscles": [
        "biceps"
      ],
      "name_en": "One-arm lat pulldown",
      "aliases": [
        "puxada um braço",
        "one arm lat pulldown",
        "single arm pulldown",
        "unilateral"
      ],
      "equipment": "cable",
      "cues_pt": [
        "Um braço de cada vez, com o tronco firme — a mão livre pode apoiar no banco",
        "Deixe o ombro subir bem no topo e depois puxe deprimindo a escápula",
        "Faça o mesmo número de repetições dos dois lados, começando pelo lado mais fraco"
      ],
      "cues_en": [
        "One arm at a time with a steady torso — the free hand can brace on the seat",
        "Let the shoulder rise fully at the top, then pull by depressing the scapula",
        "Match reps on both sides, starting with the weaker one"
      ],
      "errors_pt": [
        "Girar o tronco para ajudar a puxada",
        "Usar cargas diferentes dos dois lados sem perceber"
      ],
      "errors_en": [
        "Rotating the torso to help the pull",
        "Drifting into different loads on each side without noticing"
      ],
      "stretchEmphasis": true
    },
