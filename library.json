    {
      "id": "dumbbell-bench-press",
      "name": "Supino reto com halteres",
      "type": "hypertrophy",
      "compound": true,
      "regime": "weighted",
      "mainMuscle": "chest",
      "movementPattern": "press",
      "movement": "bench-press",
      "accessoryMuscles": [
        "triceps",
        "shoulders"
      ],
      "name_en": "Dumbbell bench press",
      "aliases": [
        "dumbbell bench press",
        "supino halteres",
        "db bench press",
        "supino com halter"
      ],
      "equipment": "dumbbell",
      "cues_pt": [
        "Halteres na linha do peito, punhos firmes, cotovelos a uns 45° do tronco",
        "Suba os dois juntos até quase se tocarem no topo, sem bater um no outro",
        "Desça controlando até um alongamento confortável do peito"
      ],
      "cues_en": [
        "Dumbbells at chest line, wrists stacked, elbows about 45° from the torso",
        "Press both up together until they nearly touch — no clanking at the top",
        "Lower under control to a comfortable chest stretch"
      ],
      "errors_pt": [
        "Bater os halteres no topo e perder a tensão do peitoral",
        "Abrir os cotovelos a 90° do tronco, jogando o esforço para o ombro"
      ],
      "errors_en": [
        "Clanking the dumbbells at the top and dumping pec tension",
        "Flaring the elbows to 90°, shifting the strain onto the shoulders"
      ],
      "stretchEmphasis": false
    },
